{
  "name": "commit-message-generator",
  "displayName": "Commit Message Generator",
  "description": "Generate commit messages from staged git diffs using Codex or Claude CLI.",
  "version": "0.0.1",
  "publisher": "semih",
  "packageManager": "npm@11.12.1",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/semih/commit-message-generator.git"
  },
  "bugs": {
    "url": "https://github.com/semih/commit-message-generator/issues"
  },
  "homepage": "https://github.com/semih/commit-message-generator#readme",
  "keywords": [
    "commit",
    "commit-message",
    "git",
    "source-control",
    "codex",
    "claude",
    "conventional-commits"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Source Control"
  ],
  "activationEvents": [
    "onCommand:commitMessageGenerator.generate",
    "onCommand:commitMessageGenerator.generate.sparkle",
    "onCommand:commitMessageGenerator.generate.hubot",
    "onCommand:commitMessageGenerator.generate.gitCommit",
    "onCommand:commitMessageGenerator.generate.commentAdd"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "commitMessageGenerator.generate",
        "title": "Generate Commit Message",
        "category": "Commit Message Generator",
        "icon": "$(sparkle)"
      },
      {
        "command": "commitMessageGenerator.generate.sparkle",
        "title": "Generate Commit Message",
        "category": "Commit Message Generator",
        "icon": "$(sparkle)"
      },
      {
        "command": "commitMessageGenerator.generate.hubot",
        "title": "Generate Commit Message",
        "category": "Commit Message Generator",
        "icon": "$(hubot)"
      },
      {
        "command": "commitMessageGenerator.generate.gitCommit",
        "title": "Generate Commit Message",
        "category": "Commit Message Generator",
        "icon": "$(git-commit)"
      },
      {
        "command": "commitMessageGenerator.generate.commentAdd",
        "title": "Generate Commit Message",
        "category": "Commit Message Generator",
        "icon": "$(comment-add)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitMessageGenerator.generate.sparkle",
          "when": "scmProvider == git && config.commitMessageGenerator.buttonIcon == 'sparkle'",
          "group": "navigation@1"
        },
        {
          "command": "commitMessageGenerator.generate.hubot",
          "when": "scmProvider == git && config.commitMessageGenerator.buttonIcon == 'hubot'",
          "group": "navigation@1"
        },
        {
          "command": "commitMessageGenerator.generate.gitCommit",
          "when": "scmProvider == git && config.commitMessageGenerator.buttonIcon == 'gitCommit'",
          "group": "navigation@1"
        },
        {
          "command": "commitMessageGenerator.generate.commentAdd",
          "when": "scmProvider == git && config.commitMessageGenerator.buttonIcon == 'commentAdd'",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "commitMessageGenerator.generate"
        },
        {
          "command": "commitMessageGenerator.generate.sparkle",
          "when": "false"
        },
        {
          "command": "commitMessageGenerator.generate.hubot",
          "when": "false"
        },
        {
          "command": "commitMessageGenerator.generate.gitCommit",
          "when": "false"
        },
        {
          "command": "commitMessageGenerator.generate.commentAdd",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Commit Message Generator",
      "properties": {
        "commitMessageGenerator.provider": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "codex",
          "description": "CLI provider used to generate commit messages."
        },
        "commitMessageGenerator.model": {
          "type": "string",
          "default": "",
          "description": "Optional model name passed to the selected CLI."
        },
        "commitMessageGenerator.buttonIcon": {
          "type": "string",
          "enum": [
            "sparkle",
            "hubot",
            "gitCommit",
            "commentAdd"
          ],
          "enumDescriptions": [
            "Sparkle icon.",
            "Hubot icon.",
            "Git commit icon.",
            "Comment add icon."
          ],
          "default": "sparkle",
          "description": "Icon used for the generate button in the Source Control toolbar."
        },
        "commitMessageGenerator.prompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "Generate a conventional commit message for this staged git diff.\n\nRequirements:\n- Use conventional commit format: type(scope?): description\n- Be concise\n- Infer the most appropriate type\n- Output only the commit message\n\nDiff:\n{diff}",
          "description": "Prompt template. Use {diff} where the staged git diff should be inserted."
        },
        "commitMessageGenerator.maxDiffLines": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Maximum number of staged diff lines sent to the CLI. Set to 0 to disable truncation."
        }
      }
    }
  }
}
