{
  "name": "local-commit-ai",
  "displayName": "Local Commit AI",
  "description": "Generate Git commit messages with your local Codex, Claude, or other AI CLI.",
  "version": "0.0.1",
  "publisher": "semiherdogan",
  "packageManager": "npm@11.12.1",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/semiherdogan/local-commit-ai.git"
  },
  "bugs": {
    "url": "https://github.com/semiherdogan/local-commit-ai/issues"
  },
  "homepage": "https://github.com/semiherdogan/local-commit-ai#readme",
  "keywords": [
    "commit",
    "commit-message",
    "git",
    "source-control",
    "codex",
    "claude",
    "conventional-commits"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "localCommitAi.generate",
        "title": "Generate Commit Message",
        "category": "Local Commit AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "localCommitAi.generate.sparkle",
        "title": "Generate Commit Message",
        "category": "Local Commit AI",
        "icon": "$(sparkle)"
      },
      {
        "command": "localCommitAi.generate.hubot",
        "title": "Generate Commit Message",
        "category": "Local Commit AI",
        "icon": "$(hubot)"
      },
      {
        "command": "localCommitAi.generate.gitCommit",
        "title": "Generate Commit Message",
        "category": "Local Commit AI",
        "icon": "$(git-commit)"
      },
      {
        "command": "localCommitAi.generate.commentAdd",
        "title": "Generate Commit Message",
        "category": "Local Commit AI",
        "icon": "$(comment-add)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "localCommitAi.generate.sparkle",
          "when": "scmProvider == git && config.localCommitAi.buttonIcon == 'sparkle'",
          "group": "navigation@1"
        },
        {
          "command": "localCommitAi.generate.hubot",
          "when": "scmProvider == git && config.localCommitAi.buttonIcon == 'hubot'",
          "group": "navigation@1"
        },
        {
          "command": "localCommitAi.generate.gitCommit",
          "when": "scmProvider == git && config.localCommitAi.buttonIcon == 'gitCommit'",
          "group": "navigation@1"
        },
        {
          "command": "localCommitAi.generate.commentAdd",
          "when": "scmProvider == git && config.localCommitAi.buttonIcon == 'commentAdd'",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "localCommitAi.generate"
        },
        {
          "command": "localCommitAi.generate.sparkle",
          "when": "false"
        },
        {
          "command": "localCommitAi.generate.hubot",
          "when": "false"
        },
        {
          "command": "localCommitAi.generate.gitCommit",
          "when": "false"
        },
        {
          "command": "localCommitAi.generate.commentAdd",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Local Commit AI",
      "properties": {
        "localCommitAi.provider": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "custom"
          ],
          "default": "codex",
          "description": "CLI provider used to generate commit messages."
        },
        "localCommitAi.model": {
          "type": "string",
          "default": "",
          "description": "Optional model name passed to the selected CLI."
        },
        "localCommitAi.buttonIcon": {
          "type": "string",
          "enum": [
            "sparkle",
            "hubot",
            "gitCommit",
            "commentAdd"
          ],
          "enumDescriptions": [
            "Sparkle icon.",
            "Hubot icon.",
            "Git commit icon.",
            "Comment add icon."
          ],
          "default": "hubot",
          "description": "Icon used for the generate button in the Source Control toolbar."
        },
        "localCommitAi.customCommand": {
          "type": "string",
          "default": "",
          "description": "Command used when provider is custom. Example: opencode"
        },
        "localCommitAi.customArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments used when provider is custom. Use {prompt} to insert the generated prompt into an argument."
        },
        "localCommitAi.customPromptStdin": {
          "type": "boolean",
          "default": true,
          "description": "Send the generated prompt to stdin when provider is custom and customArgs does not include {prompt}."
        },
        "localCommitAi.prompt": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "You are a commit message generator.\n\nReturn exactly one line and nothing else.\n\nRules:\n- Output must be a single conventional commit message\n- Format: type(scope?): description\n- Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test\n- Use lowercase type\n- Keep the description concise\n- Do not use markdown\n- Do not wrap the message in quotes\n- Do not add explanations, alternatives, notes, warnings, or recommendations\n- Do not mention whether the diff is ready to commit\n- If the diff is small or incomplete, still generate the best possible commit message\n\nStaged git diff:\n{diff}",
          "description": "Prompt template. Use {diff} where the staged git diff should be inserted."
        },
        "localCommitAi.maxDiffLines": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "Maximum number of staged diff lines sent to the CLI. Set to 0 to disable truncation."
        },
        "localCommitAi.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write generation diagnostics to the Local Commit AI output channel."
        }
      }
    }
  }
}
